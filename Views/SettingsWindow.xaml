<Window x:Class="RealmeBudsPopup.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:RealmeBudsPopup.Controls"
        mc:Ignorable="d"
        Title="Buds Studio — realme Buds T500 Pro Manager"
        Icon="/Resources/app.ico"
        Width="1060"
        Height="780"
        MinWidth="920"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        Foreground="#0F172A"
        FontFamily="Segoe UI, -apple-system, sans-serif"
        ResizeMode="CanResizeWithGrip"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <!-- Modern iOS / Win11 Toggle Switch Style -->
        <Style x:Key="FluentToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" />

                            <!-- Switch Track -->
                            <Border x:Name="Track"
                                    Grid.Column="1"
                                    Width="44"
                                    Height="24"
                                    CornerRadius="12"
                                    Background="#E2E8F0"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    Margin="12,0,0,0">
                                <!-- Switch Thumb -->
                                <Ellipse x:Name="Thumb"
                                         Width="18"
                                         Height="18"
                                         Fill="#FFFFFF"
                                         HorizontalAlignment="Left"
                                         Margin="2,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="4" Opacity="0.18" ShadowDepth="1" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2563EB" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#1D4ED8" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Flat Slider Style -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="6" CornerRadius="3" Background="#E2E8F0" />
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="18" Height="18" CornerRadius="9" Background="#2563EB" BorderBrush="#FFFFFF" BorderThickness="2">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#000000" BlurRadius="5" Opacity="0.25" ShadowDepth="1" />
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Top Navigation Bar -->
            <RowDefinition Height="Auto" />
            <!-- 2. Scrollable Studio Content -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== TOP NAVIGATION BAR ==================== -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="28,14">
            <Grid>
                <!-- Left: App Brand & Live Connection Indicator -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Path Data="M 4,2 C 2,2 1,3.5 1,5 C 1,7 3,8 3,11 C 3,13 4,14 4.5,14 L 5.5,14 C 6,14 7,13 7,11 C 7,8 9,7 9,5 C 9,3.5 8,2 6,2 Z M 13,2 C 11,2 10,3.5 10,5 C 10,7 12,8 12,11 C 12,13 13,14 13.5,14 L 14.5,14 C 15,14 16,13 16,11 C 16,8 18,7 18,5 C 18,3.5 17,2 15,2 Z"
                              Fill="#2563EB" Width="17" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Buds Studio" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Pro" FontSize="11" FontWeight="Bold" Foreground="#2563EB" />
                            </Border>
                        </StackPanel>

                        <!-- Device Connection Pill -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" VerticalAlignment="Center">
                            <Ellipse x:Name="HeaderStatusDot" Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="HeaderStatusText" Text="realme Buds T500 Pro — Подключено (COM7)" FontSize="12" Foreground="#059669" FontWeight="Medium" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Fullscreen & Quick Trigger Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="FullscreenButton"
                            Padding="12,8"
                            Background="#F1F5F9"
                            Foreground="#475569"
                            FontWeight="SemiBold"
                            FontSize="12"
                            BorderThickness="0"
                            Margin="0,0,10,0"
                            Cursor="Hand"
                            Click="FullscreenButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bdr" CornerRadius="10" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bdr" Property="Background" Value="#E2E8F0" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 1,4 L 1,1 L 4,1 M 7,1 L 10,1 L 10,4 M 10,7 L 10,10 L 7,10 M 4,10 L 1,10 L 1,7"
                                  Stroke="#475569" StrokeThickness="1.4" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform" />
                            <TextBlock x:Name="FullscreenBtnText" Text="Во весь экран" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="TestDesktopButton"
                            Padding="16,8"
                            Background="#2563EB"
                            Foreground="#FFFFFF"
                            FontWeight="SemiBold"
                            FontSize="13"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="TestDesktopButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bdr" CornerRadius="10" Background="#2563EB" Padding="{TemplateBinding Padding}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#2563EB" BlurRadius="10" Opacity="0.25" ShadowDepth="2" />
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M 3,2 L 10,6.5 L 3,11 Z" Fill="#FFFFFF" Width="9" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform" />
                                        <TextBlock Text="Проверить виджет на экране" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bdr" Property="Background" Value="#1D4ED8" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN CONTENT AREA ==================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1080" HorizontalAlignment="Stretch" Margin="32,24,32,32">

                <!-- 1. HERO BATTERY CARD (REAL LIVE HARDWARE READINGS) -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="20" Padding="28,24" Margin="0,0,0,18">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="16" Opacity="0.04" ShadowDepth="2" />
                    </Border.Effect>

                    <Grid>
                        <!-- TWS 3-Column Layout (Left Bud, Case, Right Bud) -->
                        <Grid x:Name="OverviewTwsLayout">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Earbud -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="88" Height="88">
                                    <controls:CircularGauge x:Name="OverviewLeftGauge" Width="88" Height="88" StrokeThickness="5.5" Value="80" IsAvailable="True" />
                                    <Canvas Width="38" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Rectangle x:Name="OverviewLeftStem" Canvas.Left="15" Canvas.Top="17" Width="9" Height="21" RadiusX="4.5" RadiusY="4.5" Fill="#0066CC" />
                                        <Ellipse x:Name="OverviewLeftHead" Canvas.Left="9" Canvas.Top="3" Width="21" Height="21" Fill="#0066CC" />
                                        <Ellipse x:Name="OverviewLeftTip" Canvas.Left="17" Canvas.Top="6" Width="15" Height="15" Fill="#0066CC" Stroke="#FFFFFF" StrokeThickness="1.5" />
                                    </Canvas>
                                </Grid>
                                <TextBlock x:Name="OverviewLeftPercent" Text="80%" FontSize="24" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                <TextBlock x:Name="OverviewLeftStatus" Text="В ухе" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Case -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="88" Height="88">
                                    <controls:CircularGauge x:Name="OverviewCaseGauge" Width="88" Height="88" StrokeThickness="5.5" Value="0" IsAvailable="False" />
                                    <Canvas Width="42" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Rectangle x:Name="OverviewCaseBody" Canvas.Left="1" Canvas.Top="3" Width="40" Height="26" RadiusX="13" RadiusY="13" Fill="#0066CC" />
                                        <Line Canvas.Left="1" Canvas.Top="12" X1="0" Y1="0" X2="40" Y2="0" Stroke="#FFFFFF" StrokeThickness="1.2" Opacity="0.8" />
                                        <Ellipse Canvas.Left="20" Canvas.Top="19" Width="2.5" Height="2.5" Fill="#FFFFFF" Opacity="0.9" />
                                    </Canvas>
                                </Grid>
                                <TextBlock x:Name="OverviewCasePercent" Text="—" FontSize="24" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                <TextBlock x:Name="OverviewCaseStatus" Text="Кейс (в ушах)" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Right Earbud -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="88" Height="88">
                                    <controls:CircularGauge x:Name="OverviewRightGauge" Width="88" Height="88" StrokeThickness="5.5" Value="80" IsAvailable="True" />
                                    <Canvas Width="38" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Rectangle x:Name="OverviewRightStem" Canvas.Left="14" Canvas.Top="17" Width="9" Height="21" RadiusX="4.5" RadiusY="4.5" Fill="#0066CC" />
                                        <Ellipse x:Name="OverviewRightHead" Canvas.Left="8" Canvas.Top="3" Width="21" Height="21" Fill="#0066CC" />
                                        <Ellipse x:Name="OverviewRightTip" Canvas.Left="6" Canvas.Top="6" Width="15" Height="15" Fill="#0066CC" Stroke="#FFFFFF" StrokeThickness="1.5" />
                                    </Canvas>
                                </Grid>
                                <TextBlock x:Name="OverviewRightPercent" Text="80%" FontSize="24" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                <TextBlock x:Name="OverviewRightStatus" Text="В ухе" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Over-Ear Single Column Display (Auto-detected for EDIFIER / Over-Ear) -->
                        <Grid x:Name="OverviewOverEarLayout" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="92" Height="92">
                                    <controls:CircularGauge x:Name="OverviewOverEarGauge" Width="92" Height="92" StrokeThickness="5.5" Value="80" IsAvailable="True" />
                                    <Canvas Width="48" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path x:Name="OverviewOverEarArch" Data="M 8,24 C 8,7 40,7 40,24" Stroke="#0066CC" StrokeThickness="3.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <Rectangle x:Name="OverviewOverEarLeftCup" Canvas.Left="4" Canvas.Top="20" Width="10" Height="20" RadiusX="5" RadiusY="5" Fill="#0066CC" />
                                        <Rectangle x:Name="OverviewOverEarRightCup" Canvas.Left="34" Canvas.Top="20" Width="10" Height="20" RadiusX="5" RadiusY="5" Fill="#0066CC" />
                                    </Canvas>
                                </Grid>
                                <TextBlock x:Name="OverviewOverEarPercent" Text="80%" FontSize="24" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                <TextBlock x:Name="OverviewOverEarStatus" Text="Подключено" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 2. SMART CASE DETECTION & SYSTEM SETTINGS -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,18">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="16" Opacity="0.04" ShadowDepth="2" />
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="СИСТЕМА И АВТОМАТИЧЕСКИЕ ДЕЙСТВИЯ" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,14" />

                        <!-- Smart Case Notification Status Card -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#EFF6FF" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Path Data="M 2,6 C 2,4 4,2 8,2 C 12,2 14,4 14,6 L 14,10 C 14,12 12,14 8,14 C 4,14 2,12 2,10 Z M 2,7 L 14,7"
                                      Stroke="#2563EB" StrokeThickness="1.4" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Автопоказ при подключении и открытии кейса" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" />
                                <TextBlock Text="Виджет выплывает 1 раз при подключении наушников, а также при возврате в открытый кейс" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                            </StackPanel>

                            <Border Grid.Column="2" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock Text="Включено" FontSize="12" FontWeight="SemiBold" Foreground="#059669" />
                            </Border>
                        </Grid>

                        <Border Height="1" Background="#F1F5F9" Margin="0,4,0,14" />

                        <!-- System Tray Battery -->
                        <CheckBox x:Name="ShowInTrayCheck" Style="{StaticResource FluentToggleSwitch}" IsChecked="True" Checked="SettingChanged" Unchecked="SettingChanged" Margin="0,0,0,14">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Отображать процент заряда в трее Windows (возле часов)" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" />
                                <TextBlock Text="Круглый значок с точной цифрой заряда наушников в панели задач" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>

                        <Border Height="1" Background="#F1F5F9" Margin="0,4,0,14" />

                        <!-- Windows Autostart -->
                        <CheckBox x:Name="AutorunCheck" Style="{StaticResource FluentToggleSwitch}" Checked="Autorun_Changed" Unchecked="Autorun_Changed">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Автозапуск приложения вместе с Windows" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" />
                                <TextBlock Text="Приложение запускается в фоне и моментально реагирует на подключение наушников" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- 3. DESKTOP WIDGET CUSTOMIZATION (INTERACTIVE PREVIEW & STYLING) -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,18">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="16" Opacity="0.04" ShadowDepth="2" />
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="КАСТОМИЗАЦИЯ ВСПЛЫВАЮЩЕГО ВИДЖЕТА" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,14" />

                        <!-- Stage: Interactive Live Preview Card -->
                        <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="ЖИВОЙ ПРЕДПРОСМОТР ВИДЖЕТА НА РАБОЧЕМ СТОЛЕ" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="4,0,0,10" />

                                <Border x:Name="PreviewCard" Width="416" Height="184" CornerRadius="24" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" HorizontalAlignment="Center">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="24" Opacity="0.22" ShadowDepth="4" />
                                    </Border.Effect>

                                    <Grid Margin="18,14,18,14">
                                        <!-- Preview TWS Layout -->
                                        <Grid x:Name="PreviewTwsLayout">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Left -->
                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Grid Width="78" Height="78">
                                                    <controls:CircularGauge x:Name="PreviewLeftGauge" Width="78" Height="78" StrokeThickness="5" Value="80" />
                                                    <Canvas x:Name="PreviewLeftModel" Width="38" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Rectangle x:Name="PreviewLeftStem" Canvas.Left="15" Canvas.Top="17" Width="9" Height="21" RadiusX="4.5" RadiusY="4.5" Fill="#0066CC" />
                                                        <Ellipse x:Name="PreviewLeftHead" Canvas.Left="9" Canvas.Top="3" Width="21" Height="21" Fill="#0066CC" />
                                                        <Ellipse x:Name="PreviewLeftTip" Canvas.Left="17" Canvas.Top="6" Width="15" Height="15" Fill="#0066CC" Stroke="#FFFFFF" StrokeThickness="1.5" />
                                                    </Canvas>
                                                </Grid>
                                                <TextBlock x:Name="PreviewLeftPercent" Text="80%" FontSize="19" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                                <TextBlock x:Name="PreviewLeftStatus" Text="В ухе" FontSize="12.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Case -->
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Grid Width="78" Height="78">
                                                    <controls:CircularGauge x:Name="PreviewCaseGauge" Width="78" Height="78" StrokeThickness="5" Value="40" IsAvailable="True" />
                                                    <Canvas Width="42" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Rectangle x:Name="PreviewCaseBody" Canvas.Left="1" Canvas.Top="3" Width="40" Height="26" RadiusX="13" RadiusY="13" Fill="#0066CC" />
                                                        <Line Canvas.Left="1" Canvas.Top="12" X1="0" Y1="0" X2="40" Y2="0" Stroke="#FFFFFF" StrokeThickness="1.2" Opacity="0.8" />
                                                        <Ellipse Canvas.Left="20" Canvas.Top="19" Width="2.5" Height="2.5" Fill="#FFFFFF" Opacity="0.9" />
                                                    </Canvas>
                                                </Grid>
                                                <TextBlock x:Name="PreviewCasePercent" Text="40%" FontSize="19" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                                <TextBlock x:Name="PreviewCaseStatus" Text="Кейс" FontSize="12.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Right -->
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Grid Width="78" Height="78">
                                                    <controls:CircularGauge x:Name="PreviewRightGauge" Width="78" Height="78" StrokeThickness="5" Value="80" />
                                                    <Canvas x:Name="PreviewRightModel" Width="38" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Rectangle x:Name="PreviewRightStem" Canvas.Left="14" Canvas.Top="17" Width="9" Height="21" RadiusX="4.5" RadiusY="4.5" Fill="#0066CC" />
                                                        <Ellipse x:Name="PreviewRightHead" Canvas.Left="8" Canvas.Top="3" Width="21" Height="21" Fill="#0066CC" />
                                                        <Ellipse x:Name="PreviewRightTip" Canvas.Left="6" Canvas.Top="6" Width="15" Height="15" Fill="#0066CC" Stroke="#FFFFFF" StrokeThickness="1.5" />
                                                    </Canvas>
                                                </Grid>
                                                <TextBlock x:Name="PreviewRightPercent" Text="80%" FontSize="19" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                                <TextBlock x:Name="PreviewRightStatus" Text="В ухе" FontSize="12.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Preview Over-Ear Layout -->
                                        <Grid x:Name="PreviewOverEarLayout" Visibility="Collapsed">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Grid Width="82" Height="82">
                                                    <controls:CircularGauge x:Name="PreviewOverEarGauge" Width="82" Height="82" StrokeThickness="5" Value="80" IsAvailable="True" />
                                                    <Canvas Width="46" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Path x:Name="PreviewOverEarArch" Data="M 8,23 C 8,7 38,7 38,23" Stroke="#0066CC" StrokeThickness="3.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                        <Rectangle x:Name="PreviewOverEarLeftCup" Canvas.Left="4" Canvas.Top="19" Width="9" Height="19" RadiusX="4.5" RadiusY="4.5" Fill="#0066CC" />
                                                        <Rectangle x:Name="PreviewOverEarRightCup" Canvas.Left="33" Canvas.Top="19" Width="9" Height="19" RadiusX="4.5" RadiusY="4.5" Fill="#0066CC" />
                                                    </Canvas>
                                                </Grid>
                                                <TextBlock x:Name="PreviewOverEarPercent" Text="80%" FontSize="20" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                                <TextBlock x:Name="PreviewOverEarStatus" Text="Подключено" FontSize="12.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Theme Selection (Light Apple / Dark Obsidian) -->
                        <TextBlock Text="Тема всплывающего виджета:" FontSize="13" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <RadioButton x:Name="ThemeLightRadio" Content="Светлая (Apple White)" IsChecked="True" Checked="Theme_Checked" Margin="0,0,24,0" />
                            <RadioButton x:Name="ThemeDarkRadio" Content="Тёмная (Graphite Obsidian)" Checked="Theme_Checked" />
                        </StackPanel>

                        <!-- Accent Color Swatches -->
                        <TextBlock Text="Акцентный цвет силуэтов и шкал:" FontSize="13" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button x:Name="ColorBlueBtn" Tag="Blue" Content="Синий" Click="ColorBtn_Click" Padding="14,7" Background="#0066CC" Foreground="#FFFFFF" BorderThickness="0" FontWeight="SemiBold" Margin="0,0,8,8" Cursor="Hand" />
                            <Button x:Name="ColorBlackBtn" Tag="Black" Content="Графит" Click="ColorBtn_Click" Padding="14,7" Background="#1F2937" Foreground="#FFFFFF" BorderThickness="0" FontWeight="SemiBold" Margin="0,0,8,8" Cursor="Hand" />
                            <Button x:Name="ColorWhiteBtn" Tag="White" Content="Белый" Click="ColorBtn_Click" Padding="14,7" Background="#E2E8F0" Foreground="#0F172A" BorderThickness="0" FontWeight="SemiBold" Margin="0,0,8,8" Cursor="Hand" />
                            <Button x:Name="ColorGreenBtn" Tag="Green" Content="Изумруд" Click="ColorBtn_Click" Padding="14,7" Background="#10B981" Foreground="#FFFFFF" BorderThickness="0" FontWeight="SemiBold" Margin="0,0,8,8" Cursor="Hand" />
                            <Button x:Name="ColorOrangeBtn" Tag="Orange" Content="Оранж" Click="ColorBtn_Click" Padding="14,7" Background="#F97316" Foreground="#FFFFFF" BorderThickness="0" FontWeight="SemiBold" Margin="0,0,8,8" Cursor="Hand" />
                            <Button x:Name="ColorPurpleBtn" Tag="Purple" Content="Фиолет" Click="ColorBtn_Click" Padding="14,7" Background="#8B5CF6" Foreground="#FFFFFF" BorderThickness="0" FontWeight="SemiBold" Margin="0,0,8,8" Cursor="Hand" />
                            <Button x:Name="ColorRedBtn" Tag="Red" Content="Рубин" Click="ColorBtn_Click" Padding="14,7" Background="#E11D48" Foreground="#FFFFFF" BorderThickness="0" FontWeight="SemiBold" Margin="0,0,8,8" Cursor="Hand" />
                        </WrapPanel>

                        <!-- Sliders -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="65" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Длительность показа виджета:" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" x:Name="DurationSlider" Style="{StaticResource ModernSlider}" Minimum="2" Maximum="12" Value="4.5" TickFrequency="0.5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="DurationSlider_ValueChanged" />
                            <TextBlock Grid.Column="2" x:Name="DurationLabel" Text="4.5 с" Foreground="#2563EB" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="65" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Отступ виджета от верха экрана (Y):" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" x:Name="TopYSlider" Style="{StaticResource ModernSlider}" Minimum="15" Maximum="140" Value="42" TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="TopYSlider_ValueChanged" />
                            <TextBlock Grid.Column="2" x:Name="TopYLabel" Text="42 px" Foreground="#2563EB" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>